---
import Base from '../layouts/Base.astro';
---
<Base
  title="Astrodesk — Modern astrology software by Mare Punzalan"
  description="Astrodesk is modern astrology software for professional astrologers. Natal, transits, synastry, secondary progressions, solar arc, astrocartography — built by Mare Punzalan for her own practice."
>
  <section class="stars container-awc py-24 md:py-32">
    <div class="max-w-3xl">
      <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--gold)] mb-6">The Tool I Use Daily</div>
      <h1 class="font-serif text-5xl md:text-7xl leading-[1.02]">
        <span class="italic text-[color:var(--gold-bright)]">Astrodesk</span> — the desk of a working astrologer.
      </h1>
      <p class="mt-8 text-lg text-[color:var(--ink-faint)] leading-relaxed max-w-2xl">
        Astrodesk is the professional astrology software I built for my own practice — accurate ephemeris calculations, a session-first workflow, and a design that respects the depth of the work.
      </p>
      <div class="mt-10 flex gap-4">
        <a href="https://astrodesk.astrowildchild.com" class="btn btn-primary" target="_blank" rel="noopener">
          Open Astrodesk →
        </a>
        <a href="/work-with-me" class="btn btn-ghost">Book a reading instead</a>
      </div>
    </div>

    <div class="mt-20 grid gap-8 md:grid-cols-3">
      {[
        { t: 'Accurate calculations', d: 'The math that matters — planetary positions, aspects, houses, transits — computed with the precision a professional session demands.' },
        { t: 'Session-first', d: 'Built for how astrologers actually work: one chart, one client, one story at a time. Nothing between you and the reading.' },
        { t: 'Made from the consulting room', d: "Every screen exists because a real session needed it. Not a feature checklist — a working desk shaped by two decades of client work." },
      ].map((f) => (
        <div class="card p-8">
          <h3 class="font-serif text-2xl text-[color:var(--ink-soft)]">{f.t}</h3>
          <p class="mt-3 text-[color:var(--ink-faint)] leading-relaxed">{f.d}</p>
        </div>
      ))}
    </div>
  </section>
</Base>
