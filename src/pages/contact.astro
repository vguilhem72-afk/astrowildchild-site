---
import Base from '../layouts/Base.astro';
---
<Base title="Contact Mare — Astro Wild Child">
  <section class="container-awc py-24 md:py-32">
    <div class="max-w-2xl mx-auto">
      <div class="flex justify-center mb-8">
        <img src="/images/mare-warm.jpg" alt="Mare Punzalan" width="120" height="120" class="rounded-full object-cover w-28 h-28 border border-[color:var(--gold)]/25 shadow-[0_15px_40px_-10px_rgba(0,0,0,0.5)]" loading="lazy" />
      </div>
      <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--gold)] mb-6 text-center">Contact</div>
      <h1 class="font-serif text-5xl md:text-6xl text-center leading-[1.05]">Get in touch</h1>
      <p class="mt-6 text-lg text-[color:var(--ink-faint)] text-center leading-relaxed">
        For readings, book directly via the <a href="/work-with-me" class="underline decoration-[color:var(--gold)]/50">work with me</a> page. For everything else — collaborations, press, thoughtful questions — write below.
      </p>

      <form id="contact-form" class="mt-12 space-y-5" novalidate>
        <div>
          <label for="cf-name" class="block text-xs uppercase tracking-widest text-[color:var(--gold)] mb-2">Name</label>
          <input
            id="cf-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            maxlength="120"
            class="w-full px-4 py-3 bg-[color:var(--night-deep)] border border-white/10 focus:outline-none focus:border-[color:var(--gold)] rounded-sm text-[color:var(--ink)] transition-colors"
          />
        </div>
        <div>
          <label for="cf-email" class="block text-xs uppercase tracking-widest text-[color:var(--gold)] mb-2">Email</label>
          <input
            id="cf-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            maxlength="200"
            placeholder="you@somewhere.com"
            class="w-full px-4 py-3 bg-[color:var(--night-deep)] border border-white/10 focus:outline-none focus:border-[color:var(--gold)] rounded-sm text-[color:var(--ink)] transition-colors"
          />
        </div>
        <div>
          <label for="cf-message" class="block text-xs uppercase tracking-widest text-[color:var(--gold)] mb-2">Message</label>
          <textarea
            id="cf-message"
            name="message"
            required
            rows="6"
            maxlength="5000"
            class="w-full px-4 py-3 bg-[color:var(--night-deep)] border border-white/10 focus:outline-none focus:border-[color:var(--gold)] rounded-sm text-[color:var(--ink)] transition-colors"
          ></textarea>
        </div>

        {/* Honeypot — kept off-screen for humans, filled by bots.
            Server treats a non-empty value as spam and drops the message. */}
        <div aria-hidden="true" style="position:absolute;left:-5000px;top:auto;width:1px;height:1px;overflow:hidden;">
          <label>Leave this empty
            <input type="text" name="_website" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <div class="flex items-center gap-4">
          <button type="submit" class="btn btn-primary" data-submit>Send message</button>
          <span id="cf-status" class="text-sm" aria-live="polite"></span>
        </div>

        <p class="text-xs text-[color:var(--ink-mute)] leading-relaxed">
          I reply personally, usually within a few days. For readings, book directly via the
          <a href="/work-with-me" class="underline decoration-[color:var(--gold)]/50">work with me</a> page.
        </p>
      </form>

      <script>
        // Progressive enhancement — the form still POSTs even without JS thanks
        // to the `action` we don't set (fallback below); but with JS enabled we
        // hijack submit for a smoother experience: inline status, no reload,
        // clear form on success.
        const form = document.getElementById('contact-form') as HTMLFormElement | null;
        const status = document.getElementById('cf-status');
        if (form && status) {
          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = form.querySelector('[data-submit]') as HTMLButtonElement | null;
            const orig = btn?.textContent ?? 'Send message';
            if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
            status.textContent = '';
            status.className = 'text-sm';

            try {
              const res = await fetch('/api/contact', {
                method: 'POST',
                body: new FormData(form),
              });
              const data = await res.json().catch(() => ({}));

              if (res.ok && data.ok) {
                status.textContent = 'Sent — thank you, I’ll reply soon.';
                status.className = 'text-sm text-[color:var(--gold-bright)]';
                form.reset();
              } else {
                status.textContent = data.error || 'Something went wrong. Please try again.';
                status.className = 'text-sm text-red-300';
              }
            } catch {
              status.textContent = 'Network error. Please try again.';
              status.className = 'text-sm text-red-300';
            } finally {
              if (btn) { btn.disabled = false; btn.textContent = orig; }
            }
          });
        }
      </script>
    </div>
  </section>
</Base>
