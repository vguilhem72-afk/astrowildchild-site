---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const all = (await getCollection('posts', ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return paginate(all, { pageSize: 12 });
};

const { page } = Astro.props;
---
<Base title={`Journal — Page ${page.currentPage} — Astro Wild Child`}>
  <section class="container-awc py-20 md:py-28">
    <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--gold)] mb-6">Journal</div>
    <h1 class="font-serif text-5xl md:text-6xl">Page {page.currentPage}</h1>

    <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {page.data.map((p) => (
        <PostCard
          href={`/blog/${p.slug}/`}
          title={p.data.title}
          date={p.data.date}
          excerpt={p.data.excerpt}
          image={p.data.featured_image}
          category={p.data.categories[0]}
        />
      ))}
    </div>

    <div class="mt-16 flex justify-between">
      {page.url.prev ? <a href={page.url.prev} class="btn btn-ghost">← Newer</a> : <span />}
      {page.url.next ? <a href={page.url.next} class="btn btn-ghost">Older →</a> : <span />}
    </div>
  </section>
</Base>
