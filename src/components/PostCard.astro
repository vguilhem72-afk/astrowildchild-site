---
export interface Props {
  href: string;
  title: string;
  date: Date;
  excerpt?: string;
  image?: string;
  category?: string;
}
const { href, title, date, excerpt, image, category } = Astro.props;
const dateStr = date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<a href={href} class="card block group">
  {image && (
    <div class="aspect-[16/10] overflow-hidden bg-[color:var(--wine-deep)]">
      <img
        src={image}
        alt={title}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-500 ease-awc group-hover:scale-105"
      />
    </div>
  )}
  <div class="p-6">
    {category && (
      <div class="text-[10px] uppercase tracking-[0.2em] text-[color:var(--gold)] mb-3">{category}</div>
    )}
    <h3 class="font-serif text-xl md:text-2xl leading-tight text-[color:var(--ink)] group-hover:text-[color:var(--gold-bright)] transition-colors">
      {title}
    </h3>
    {excerpt && (
      <p class="mt-3 text-sm text-[color:var(--ink-faint)] leading-relaxed line-clamp-3">{excerpt}</p>
    )}
    <div class="mt-4 text-xs text-[color:var(--ink-mute)] uppercase tracking-widest">{dateStr}</div>
  </div>
</a>
