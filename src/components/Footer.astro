---
const year = new Date().getFullYear();
---
<footer class="mt-32 border-t border-white/5 bg-[color:var(--wine-deep)]/40">
  <div class="container-awc py-16 grid gap-10 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="flex items-center gap-4 mb-4">
        <img src="/images/mare-warm.jpg" alt="" width="56" height="56" class="rounded-full object-cover w-14 h-14 border border-[color:var(--gold)]/25" loading="lazy" />
        <div class="font-serif text-2xl text-[color:var(--ink)]">
          astro <span class="italic text-[color:var(--gold-bright)]">wild</span> child
        </div>
      </div>
      <p class="mt-2 text-sm text-[color:var(--ink-faint)] max-w-sm leading-relaxed">
        Astrology, astrocartography, and cosmic guidance by Mare Punzalan. Toronto-based, working worldwide.
      </p>
    </div>
    <div>
      <div class="text-xs uppercase tracking-[0.15em] text-[color:var(--gold)] mb-4">Explore</div>
      <ul class="space-y-2 text-sm">
        <li><a href="/about">About Mare</a></li>
        <li><a href="/work-with-me">Work with Me</a></li>
        <li><a href="/shop">Shop</a></li>
        <li><a href="/blog">Journal</a></li>
        <li><a href="/astrodesk">Astrodesk (Tool)</a></li>
      </ul>
    </div>
    <div>
      <div class="text-xs uppercase tracking-[0.15em] text-[color:var(--gold)] mb-4">Connect</div>
      <ul class="space-y-2 text-sm">
        <li><a href="https://instagram.com/astro.wild.child/" target="_blank" rel="noopener">Instagram</a></li>
        <li><a href="https://facebook.com/astrowildchild/" target="_blank" rel="noopener">Facebook</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/5">
    <div class="container-awc py-6 flex flex-col md:flex-row justify-between gap-3 text-xs text-[color:var(--ink-mute)]">
      <div>© {year} Astro Wild Child. All rights reserved.</div>
      <div class="flex gap-5">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </div>
    </div>
  </div>
</footer>
